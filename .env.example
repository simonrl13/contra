# Copy to .env (git-ignored) and change the password.
# Read by docker compose (Postgres container) and by the app (spring.config.import in application.yml).
# If port 5432 is already used on your machine, change DB_PORT and the port in DB_URL together.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/contra
DB_USERNAME=contra
DB_PASSWORD=change-me
